{
  "name": "@hth/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./dashboard-process": {
      "types": "./dist/dashboard-process.d.ts",
      "import": "./dist/dashboard-process.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "broker:check": "tsx --env-file-if-exists=../../.env src/readonly.ts",
    "broker:sync": "tsx --env-file-if-exists=../../.env src/readonly.ts --save",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hth/contracts": "workspace:*",
    "@hth/trading": "workspace:*",
    "@hth/broker": "workspace:*",
    "@hth/database": "workspace:*",
    "zod": "^4.6.7",
    "decimal.js": "^10.6.0"
  }
}
