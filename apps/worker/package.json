{
  "name": "@hth/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./dashboard-process": {
      "types": "./dist/dashboard-process.d.ts",
      "import": "./dist/dashboard-process.js"
    },
    "./paper-preparation-query": {
      "types": "./dist/paper-preparation-query.d.ts",
      "import": "./dist/paper-preparation-query.js"
    },
    "./paper-validation-status": {
      "types": "./dist/paper-validation-status.d.ts",
      "import": "./dist/paper-validation-status.js"
    },
    "./observation-evidence": {
      "types": "./dist/observation-evidence.d.ts",
      "import": "./dist/observation-evidence.js"
    },
    "./backtest-comparison": {
      "types": "./dist/backtest-comparison.d.ts",
      "import": "./dist/backtest-comparison.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "broker:check": "tsx --env-file-if-exists=../../.env src/readonly.ts",
    "broker:sync": "tsx --env-file-if-exists=../../.env src/readonly.ts --save",
    "data:backfill": "tsx --env-file-if-exists=../../.env src/data-backfill.ts",
    "data:export": "tsx --env-file-if-exists=../../.env src/data-export.ts",
    "backtest:run": "tsx --env-file-if-exists=../../.env src/backtest-run.ts",
    "risk:demo": "tsx src/risk-demo-run.ts",
    "paper:demo": "tsx src/paper-demo-run.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "paper:market": "tsx --env-file-if-exists=../../.env src/paper-market-run.ts",
    "paper:day-review": "tsx --env-file-if-exists=../../.env src/paper-day-review-run.ts",
    "market:observe": "tsx --env-file-if-exists=../../.env src/market-observation-run.ts",
    "paper:rehearse": "tsx src/paper-rehearsal-run.ts",
    "paper:plan": "tsx src/paper-market-plan-run.ts",
    "paper:prepare": "tsx src/paper-prepare-run.ts",
    "paper:review": "tsx src/paper-review-run.ts",
    "backtest:experiment": "tsx src/backtest-experiment-run.ts",
    "backtest:experiment:review": "tsx src/backtest-experiment-review-run.ts",
    "paper:validation:status": "node --import tsx src/paper-validation-status-run.ts",
    "paper:run:diagnostics": "node --import tsx src/paper-run-diagnostics-run.ts",
    "readonly:process:check": "node --import tsx src/readonly-process-check-run.ts",
    "paper:validation:preflight": "node --import tsx src/paper-validation-preflight-run.ts",
    "readonly:validation:plan": "node --import tsx src/readonly-validation-plan-run.ts",
    "readonly:supervise": "node dist/readonly-observation-supervisor-run.js",
    "readonly:supervision:status": "node dist/readonly-supervision-status-run.js",
    "paper:reservation:closure": "node dist/paper-reservation-closure-run.js",
    "paper:validation:owned": "node dist/owned-paper-validation-run.js",
    "paper:warmup:plan": "node dist/paper-warmup-run.js",
    "broker:commissions": "tsx src/commission-check-run.ts",
    "commission:review": "tsx src/commission-review-run.ts",
    "backtest:strategies": "tsx src/strategy-study-run.ts"
  },
  "dependencies": {
    "@hth/contracts": "workspace:*",
    "@hth/trading": "workspace:*",
    "@hth/broker": "workspace:*",
    "@hth/database": "workspace:*",
    "zod": "^4.6.7",
    "decimal.js": "^10.6.0"
  }
}
