NODE_ENV=development
TRADING_MODE=paper
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# corepack pnpm owner:hash 가 만드는 .env.owner에서 소유자 해시를 읽습니다.
# 비밀번호 원문·세션 값을 여기에 넣거나 VITE_* 환경변수에 등록하지 않습니다.
DATABASE_URL=postgresql://hth:hth_local_only@localhost:5432/hth_trading
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
READONLY_SYMBOLS=KR:005930,US:AAPL
CANDLE_INTERVAL=1m
CANDLE_MAX_PAGES=1
DASHBOARD_ENABLED=false
PAPER_DASHBOARD_ENABLED=false
# 합성 Paper 대시보드 전용. 일반 DATABASE_URL/실제 계좌와 분리합니다.
# PAPER_DEMO_DATABASE_URL=postgresql://hth_test:local_test_only@127.0.0.1:55433/hth_readonly_test
# PAPER_DEMO_ACCOUNT_ID=paper-demo-local
# 실제 시세 Paper CLI 전용 테스트 DB. 위 DATABASE_URL(토큰 잠금 DB)과 분리합니다.
# paper:market은 이 설정만으로 시작/재개하지 않습니다.
# PAPER_MARKET_DATABASE_URL=postgresql://hth_test:local_test_only@127.0.0.1:55434/hth_readonly_test
