# Copy to infra/.env.local (ignored). Never reuse the root .env automatically.
LOCAL_WEB_PORT=5173
LOCAL_DB_PASSWORD=hth_local_only
# Paste only the hash from the owner:hash command, never the plaintext password.
LOCAL_OWNER_PASSWORD_HASH=

# A separate DB role/DB is bootstrapped only on a new PostgreSQL volume.
LOCAL_PAPER_DB_PASSWORD=local_paper_only
LOCAL_WORKER_MODE=idle
LOCAL_WORKER_SOURCE=synthetic-only
LOCAL_WORKER_SYMBOLS=KR:005930
LOCAL_WORKER_SAMPLES=60
LOCAL_WORKER_INTERVAL_SECONDS=60
# observe requires a NEW UUID; the same ID is never replayed after restart.
LOCAL_WORKER_REQUEST_ID=
# Configure only after explicit local:paper:prepare, never auto-created on boot.
LOCAL_PAPER_ACCOUNT_ID=
LOCAL_PAPER_KIND=synthetic
LOCAL_PAPER_DASHBOARD_ENABLED=false
LOCAL_MARKET_DASHBOARD_ENABLED=false
LOCAL_TOSS_CLIENT_ID=
LOCAL_TOSS_CLIENT_SECRET=
